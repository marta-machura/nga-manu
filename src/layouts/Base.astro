---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <a href="/" class="site-name"><span lang="mi">Ngā Manu</span> · Birds of Aotearoa</a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>
        Data and images from
        <a href="https://data.tepapa.govt.nz">Te Papa's Collections API</a>,
        used under the licence shown on each image.
        An independent learning project, not affiliated with Te Papa.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --text: #1f1d1a;
    --muted: #5c574f;
    --accent: #0b6e4f;
    --card: #ffffff;
    --border: #e4e0d8;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161513;
      --text: #f1eee8;
      --muted: #b5afa5;
      --accent: #5fd3a6;
      --card: #211f1c;
      --border: #3a3631;
    }
  }

  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    background: var(--bg);
    color: var(--text);
  }

  header,
  main,
  footer {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem;
  }

  a {
    color: var(--accent);
  }

  a:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .site-name {
    font-weight: 700;
    text-decoration: none;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
    background: var(--card);
    padding: 0.5rem 1rem;
  }

  footer {
    color: var(--muted);
    font-size: 0.875rem;
    border-top: 1px solid var(--border);
  }
</style>
